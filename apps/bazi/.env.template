                # Firebase Client (公開，前端使用)
# 來源：Firebase Console → Project Settings → Your apps → Web app → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Admin (私密，只在 Server 使用)
# 來源：Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Admin UID（你自己帳號的 Firebase UID，用來驗證管理員身份）
# 來源：Firebase Console → Authentication → Users → 找你的帳號 → 複製 User UID
ADMIN_UID=
NEXT_PUBLIC_ADMIN_UID=

# Gemini API Key
# 來源：https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=
NEXT_PUBLIC_SITE_URL=

# 推播通知（Web Push）：排盤在背景算好時通知手機。沒填就不顯示「算好時通知我」
# 產生方式：npx web-push generate-vapid-keys，公鑰填 NEXT_PUBLIC_VAPID_PUBLIC_KEY、私鑰填 VAPID_PRIVATE_KEY
# VAPID_SUBJECT 填 mailto:你的信箱（推播服務需要一個聯絡方式）
# iPhone 要先「加入主畫面」並從主畫面打開才能開通知（iOS 16.4 以上）
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# 訪客 Demo 模式（作品集展示用，網址加 ?demo=1 首頁才會出現「訪客體驗」按鈕）
# 1. Firebase Console → Authentication → Sign-in method 啟用「匿名」
# 2. 範例命盤存在 Firestore 的 baziDemoReadings，跟正式的 readings 分開；每天台灣時間 04:00 由 Vercel Cron 清空（vercel.json）
# CRON_SECRET：Vercel 專案的環境變數設一組隨機字串；沒設定時清空排程不會執行（訪客每天第一次進來仍會換新範例）
CRON_SECRET=
# 範例命盤的範本：用管理員帳號替虛構人物排盤後，把那份命盤的 id 填這裡；不填就用內建範例
DEMO_TEMPLATE_READING_ID=
# 所有訪客加起來每天最多幾次 AI 呼叫（追問、完整分析、翻譯；預設 100）
DEMO_GLOBAL_DAILY_AI=

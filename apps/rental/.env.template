# Gemini API Key（解析截圖用，跟 apps/bazi 同一把即可）
# 來源：https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=

# 解析截圖用的模型，可不填（預設 gemini-2.5-flash）
GEMINI_MODEL=

# Google Maps（地圖、地址轉座標）
# 來源：Google Cloud Console → APIs & Services → 啟用 Maps JavaScript API、Geocoding API → Credentials 建立 API key
# 記得在 key 的「Application restrictions」限制成你的網域（HTTP referrers）
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Advanced Marker 需要 Map ID。開發時可不填（會用 DEMO_MAP_ID），正式上線建議到 Google Maps Platform → Map Management 建一個
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Google 登入（Firebase Authentication）：可以跟 apps/bazi 共用同一個 Firebase 專案
# 來源：Firebase Console → 專案設定 → 一般 → 你的應用程式（網頁）
# 記得到 Authentication → Settings → Authorized domains 加上這個網站的網域
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# 允許使用 AI 解析的 Google 帳號，多個用逗號分隔（必填，沒填任何人都不能用 AI 解析）
ALLOWED_EMAILS=
